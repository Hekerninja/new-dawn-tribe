rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      // Allow users to read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow admin users to read all user data (for leaderboard functionality)
      allow read: if request.auth != null &&
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

      // Allow admin users to write to any user document
      allow write: if request.auth != null &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Allow read access to users collection for testing purposes
    // This is temporary and should be removed in production
    match /users {
      allow read: if request.auth != null;
    }

    // Strictly deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}