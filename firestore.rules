rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - users can read leaderboard (names and streaks only)
    // Users can only read their own full profile
    // Only admins can modify user data
    match /users/{userId} {
      // Anyone can read basic leaderboard data (name and streak only)
      allow read: if isAuthenticated();
      
      // Users can read their own full profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Only the user themselves can update their own profile (limited fields)
      allow update: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['name', 'email']) &&
        request.resource.data.keys().size() <= 5;
      
      // Only admins can delete users or modify admin status
      allow delete: if isAdmin();
      allow create: if isAdmin() || request.resource.data.isAdmin == false;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}