rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Development rules - more permissive for testing
    match /users/{userId} {
      // Allow read access to all authenticated users for development
      allow read: if request.auth != null;

      // Allow write access to own data or if admin
      allow write: if request.auth != null &&
                  (request.auth.uid == userId ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Allow read access to users collection for leaderboard functionality
    match /users {
      allow read: if request.auth != null;
    }

    // Allow write access to users collection for admin functionality
    allow write: if request.auth != null &&
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

    // Strictly deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}